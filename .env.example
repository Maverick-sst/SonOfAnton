# === Son of Anton Environment Variables ===

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VOICE_MODEL=gpt-4o-mini

# GitHub
GITHUB_TOKEN=ghp_...
GITHUB_REPOS=Maverick-sst/Anton,Maverick-sst/odysseus,Maverick-sst/terax-ai,Musharraf1128/Morph,Maverick-sst/Stratum,Maverick-sst/DevForge,Maverick-sst/Doable,Maverick-sst/MisoTTS

# ─── Vapi (Voice) ───────────────────────────────────────────────────────────
# Dashboard: https://dashboard.vapi.ai
VAPI_API_KEY=
# Phone Number ID — set after importing the Twilio number into Vapi.
VAPI_PHONE_NUMBER_ID=
# Assistant ID — set after running backend/scripts/create_vapi_assistant.py.
VAPI_ASSISTANT_ID=
# Optional webhook signature secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
VAPI_SERVER_SECRET=

# ─── Twilio (Phone number imported into Vapi) ───────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# ─── Local dev (ngrok) ──────────────────────────────────────────────────────
# Set to the https URL ngrok prints (e.g. https://xxxx.ngrok-free.app).
# Leave empty in production; the deployed URL is hard-coded into the
# Vapi assistant when you run backend/scripts/create_vapi_assistant.py.
BACKEND_PUBLIC_URL=

# Redis (Upstash)
REDIS_URL=rediss://default:...@....upstash.io:6379

# Google Calendar OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_TOKEN_JSON=

# PostgreSQL (Supabase)
DATABASE_URL=postgresql://...

# Rehan's email (for calendar invites)
REHAN_EMAIL=rehan@example.com

# ChromaDB
CHROMA_PERSIST_PATH=./data/chroma

# Retrieval
RETRIEVAL_SCORE_THRESHOLD=0.35

# LangSmith (Observability)
LANGSMITH_API_KEY=ls__...
