# Son of Anton — Environment Variables
# Copy this file to `.env` for local dev, and set the same keys (minus the
# NEXT_PUBLIC_ frontend ones) in your Render dashboard for production.
# Never commit `.env` to git.

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VOICE_MODEL=gpt-4o-mini

# ─── GitHub (for ingestion + live fallback) ──────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_REPOS=Maverick-sst/Anton,Maverick-sst/odysseus,Maverick-sst/Doable,Maverick-sst/terax-ai,Maverick-sst/Stratum,Maverick-sst/DevForge,Maverick-sst/MisoTTS,Musharraf1128/Morph

# ─── Vapi (voice) ────────────────────────────────────────────────────────────
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_SERVER_SECRET=        # any long random string; must match in Vapi dashboard

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
# Local dev:   REDIS_URL=redis://localhost:6379
# Production:  REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ─── Google Calendar ─────────────────────────────────────────────────────────
# In production, paste the full contents of your local `backend/data/token.json`
# as a single-line JSON string here. DO NOT commit token.json to git.
GOOGLE_TOKEN_JSON=

# Recruiter's email (calendar invite attendee)
REHAN_EMAIL=rehan@example.com

# ─── ChromaDB ────────────────────────────────────────────────────────────────
# Local:  ./data/chroma
# Render: /app/data/chroma  (ephemeral, re-ingested on startup)
CHROMA_PERSIST_PATH=./data/chroma

# ─── Retrieval ───────────────────────────────────────────────────────────────
RETRIEVAL_SCORE_THRESHOLD=0.35

# ─── Optional: extra CORS origins (comma-separated) ─────────────────────────
# EXTRA_CORS_ORIGINS=https://your-custom-domain.com

# ─── Frontend-only (set in Vercel, NOT here) ─────────────────────────────────
# NEXT_PUBLIC_BACKEND_URL=https://son-of-anton-api.onrender.com
# NEXT_PUBLIC_VAPI_PUBLIC_KEY=
# NEXT_PUBLIC_VAPI_ASSISTANT_ID=
